  "schema": {
    "columns": [
      {"name":"webapp_id","type":"string","comment":"Unique identifier for each web application. Key for tracking.","meaning":"Text","isColumnEdited":true},
      {"name":"webapp_name","type":"string","comment":"Descriptive name of the web application. Identifies purpose.","meaning":"Text","isColumnEdited":true},
      {"name":"projectKey","type":"string","comment":"Identifier for the associated project. Links app to project.","meaning":"Text","isColumnEdited":true},
      {"name":"webapp_type","type":"string","comment":"Type or category of the web application. Defines function.","meaning":"Text","isColumnEdited":true},
      {"name":"backend_running","type":"boolean","comment":"Indicates if the backend is currently running. Status check.","meaning":"Boolean","isColumnEdited":true},
      {"name":"created_by_user","type":"string","comment":"Email of the user who created the app. Creator identity.","meaning":"Text","isColumnEdited":true},
      {"name":"last_modified_user","type":"string","comment":"Email of the user who last modified the app. Modifier identity.","meaning":"Text","isColumnEdited":true},
      {"name":"created_timestamp","type":"datetimenotz","comment":"Timestamp when the app was created. Tracks creation date.","meaning":"DatetimeNoTz","isColumnEdited":true},
      {"name":"last_modified_timestamp","type":"datetimenotz","comment":"Timestamp of the last modification. Tracks update date.","meaning":"DatetimeNoTz","isColumnEdited":true},
      {"name":"tags","type":"string","comment":"JSON array of tags for categorization. Organizes apps.","meaning":"JSONArrayMeaning","isColumnEdited":true},
      {"name":"is_code_webapp","type":"boolean","comment":"Indicates if the app is code-based. Differentiates app type.","meaning":"Boolean","isColumnEdited":true},
      {"name":"url","type":"string","comment":"URL for accessing the web application. Direct access link.","meaning":"URL","isColumnEdited":true}
    ],
